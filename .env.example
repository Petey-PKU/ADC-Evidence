# Keep extractive for the no-cost offline default. Change to siliconflow or
# openai only after configuring that provider's key.
ADC_LLM_BACKEND=extractive

# Public deployments should keep expert-review writes disabled. This does not
# make the SQLite file read-only because first startup still bootstraps demo data.
ADC_PUBLIC_DEMO=true

# Production host settings used by compose.prod.yaml.
ADC_HOST_PORT=8501
ADC_DATA_DIR=/srv/adc-evidence-data
ADC_BACKUP_DIR=/srv/adc-evidence-backups

# Optional: SiliconFlow Chat Completions backend.
# Never commit a real key; place it only in the ignored local .env file.
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash

# Optional: OpenAI Responses API backend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Optional. NCBI recommends identifying API clients with an email address.
NCBI_EMAIL=
NCBI_API_KEY=
